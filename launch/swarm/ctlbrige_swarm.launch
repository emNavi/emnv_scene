<launch>
    <arg name = "takeoff_height" default = "2.0"/>
    <!-- RATE,ATTI,POSY  -->
    <arg name = "ctrl_pub_level" default = "POSY"/>
    <arg name = "ctrl_mode" default = "POSY"/>
    <!-- MAVROS and vehicle configs -->
    <node pkg="tf" type="static_transform_publisher" name="map_to_world" args="0 0 0 0 0 0 1 map world 100" />
    <!-- <param name="use_sim_time" value="true"/> -->
    <!--集群初始位姿-->
    <arg name= "swarm_racer_flage" default="true"/>
    <arg name = "racer_x_1" default = "2.0"/>   <arg name = "racer_y_1" default = "0.0"/>   <arg name = "racer_z_1" default = "0.0"/>
    <arg name = "racer_x_2" default = "2.0"/>   <arg name = "racer_y_2" default = "0.0"/>   <arg name = "racer_z_2" default = "0.0"/>
    <arg name = "racer_x_3" default = "-2.0"/>  <arg name = "racer_y_2" default = "0.0"/>   <arg name = "racer_z_3" default = "0.0"/>
    <arg name = "racer_x_4" default = "0.0"/>   <arg name = "racer_y_4" default = "2.0"/>   <arg name = "racer_z_4" default = "0.0"/>

    <group ns="iris_1">
    <param name = "use_sim_time" value="true"/>
        <arg name="ID" value="0"/>
        <arg name="fcu_url" default="udp://:1454$(arg ID)@localhost:1455$(arg ID)"/>
        <arg name="gcs_url" value="udp://:14556@192.168.8.192:14550"/>
        <node name = "ctrl_bridge_$(arg ID)" pkg = "emnv_ctl_bridge" type = "ctrl_bridge" output = "screen" required="true">
            <remap from="~pos_sp_cmd" to="/drone_1_planning/pos_cmd"/>
            <remap from="~ref_odom" to="/iris_1/mavros/local_position/odom"/>
            <param name ="enable_vel_transpose_b2w" value="true"/>
            <param name ="enable_imu_dt_check" value="false"/>
            <param name ="drone_config_path" value="$(find emnv_ctl_bridge)/config/drone_gazebo_iris.yaml"/>
            <param name ="drone_name" value="iris_1"/>
            <param name ="takeoff_height" value="2"/>
            <param name ="ctrl_pub_level" value="$(arg ctrl_pub_level)"/>
            <param name ="ctrl_mode" value="$(arg ctrl_mode)"/>

            <param name="racer_x" value="($arg racer_x_1)"/>	
            <param name="racer_y" value="($arg racer_y_1)"/>
            <param name="racer_z" value="($arg racer_z_1)"/>
            <param name="swarm_racer_flage" value="$(arg swarm_racer_flage)"/>
        </node>
        <include file="$(find mavros)/launch/px4.launch" >
            <arg name="fcu_url" value="$(arg fcu_url)"/>
            <arg name="gcs_url" value="$(arg gcs_url)"/>
            <arg name="tgt_system" value="$(eval 1 + arg('ID'))"/>
            <arg name="tgt_component" value="1"/>
        </include>
    </group> 

    <group ns="iris_2">
    <param name = "use_sim_time" value="true"/>
        <arg name="ID" value="1"/>
        <arg name="fcu_url" default="udp://:1454$(arg ID)@localhost:1455$(arg ID)"/>
        <arg name="gcs_url" value="udp://:14556@192.168.8.192:14550"/>
        <node name = "ctrl_bridge_$(arg ID)" pkg = "emnv_ctl_bridge" type = "ctrl_bridge" output = "screen" required="true">
            <remap from="~pos_sp_cmd" to="/drone_2_planning/pos_cmd"/>
            <remap from="~ref_odom" to="/iris_2/mavros/local_position/odom"/>
            <param name ="enable_vel_transpose_b2w" value="true"/>
            <param name ="enable_imu_dt_check" value="false"/>
            <param name ="drone_config_path" value="$(find emnv_ctl_bridge)/config/drone_gazebo_iris.yaml"/>
            <param name ="drone_name" value="iris_2"/>
            <param name ="takeoff_height" value="1"/>
            <param name ="ctrl_pub_level" value="$(arg ctrl_pub_level)"/>
            <param name ="ctrl_mode" value="$(arg ctrl_mode)"/>
            <!--集群相对位置偏移-->
            <param name="racer_x" value="($arg racer_x_1)"/>	
            <param name="racer_y" value="($arg racer_y_1)"/>
            <param name="racer_z" value="($arg racer_z_1)"/>
            <param name="swarm_racer_flage" value="$(arg swarm_racer_flage)"/>
        </node>
        <include file="$(find mavros)/launch/px4.launch" >
            <arg name="fcu_url" value="$(arg fcu_url)"/>
            <arg name="gcs_url" value="$(arg gcs_url)"/>
            <arg name="tgt_system" value="$(eval 1 + arg('ID'))"/>
            <arg name="tgt_component" value="1"/>
        </include>
    </group>     
    
    <!-- <group ns="iris_3">
    <param name = "use_sim_time" value="true"/>
        <arg name="ID" value="2"/>
